{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gov-agentic-ai/authority_matrix.schema.json",
  "title": "Authority Matrix",
  "type": "object",
  "required": ["version", "roles"],
  "properties": {
    "version": { "type": "string" },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role_slug",
          "role_name",
          "cluster",
          "role_class",
          "can_draft",
          "can_review",
          "can_recommend",
          "can_escalate",
          "cannot"
        ],
        "properties": {
          "role_slug": { "type": "string" },
          "role_name": { "type": "string" },
          "cluster": { "type": "string" },
          "role_class": {
            "type": "string",
            "enum": ["router", "specialist", "monitor", "escalation"]
          },
          "can_draft": { "type": "boolean" },
          "can_review": { "type": "boolean" },
          "can_recommend": { "type": "boolean" },
          "can_escalate": { "type": "boolean" },
          "cannot": {
            "type": "array",
            "items": { "type": "string" }
          },
          "default_next_handoff": { "type": ["string", "null"] },
          "approval_owner_hint": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
