{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gov-Agentic AI Runtime Config",
  "type": "object",
  "required": [
    "project_name",
    "project_version",
    "runtime_target",
    "memory_mode",
    "governance_mode",
    "agent_entrypoint",
    "runtime_handshake",
    "bootstrap_example",
    "system_prompt",
    "shared_guardrail_skill",
    "audit_schema",
    "acceptance_tests",
    "active_clusters",
    "active_roles",
    "active_skills",
    "knowledge_base_root",
    "shared_knowledge_root",
    "human_approval_required_for",
    "adapter_name",
    "adapter_profile_path",
    "runtime_paths",
    "runtime_overrides",
    "governance_policy",
    "runtime_discovery",
    "runtime_installation",
    "runtime_config_targets",
    "default_router_role",
    "default_router_alias",
    "default_router_skill",
    "output_contract_required_fields",
    "runtime_boot_sequence",
    "runtime_pack_root",
    "central_pack_root",
    "install_target_root",
    "install_target_config",
    "install_target_skills",
    "install_target_type",
    "install_mode",
    "install_applied",
    "installed_at",
    "government_work_logic",
    "authority_matrix",
    "decision_engine",
    "decision_engine_entrypoint",
    "central_home_root",
    "runtime_shim_root",
    "runtime_attach_mode",
    "canonical_repo_root",
    "shim_installed_skills",
    "canonical_skill_manifest",
    "canonical_knowledge_root",
    "canonical_system_prompt",
    "canonical_agent_entrypoint",
    "canonical_runtime_config",
    "adapter_capabilities"
  ],
  "properties": {
    "runtime_target": {
      "enum": [
        "openclaw",
        "hermes",
        "codex",
        "claude",
        "antigravity",
        "generic"
      ]
    },
    "memory_mode": {
      "enum": [
        "local",
        "mem9",
        "hybrid"
      ]
    },
    "governance_mode": {
      "enum": [
        "sandbox",
        "production"
      ]
    },
    "install_target_type": {
      "enum": [
        "runtime-home",
        "global-surface"
      ]
    },
    "install_mode": {
      "enum": [
        "copy"
      ]
    },
    "runtime_attach_mode": {
      "enum": [
        "thin-shim"
      ]
    },
    "runtime_installation": {
      "type": "object"
    },
    "runtime_discovery": {
      "type": "object"
    },
    "runtime_paths": {
      "type": "object"
    },
    "runtime_overrides": {
      "type": "object"
    },
    "decision_engine": {
      "type": "object"
    },
    "active_clusters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active_roles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "active_skills": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "shim_installed_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adapter_capabilities": {
      "type": "object"
    }
  }
}
