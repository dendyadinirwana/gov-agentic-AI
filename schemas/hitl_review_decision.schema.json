{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gov-Agentic AI HITL Review Decision",
  "type": "object",
  "required": [
    "contract_version",
    "trace_id",
    "review_id",
    "decision",
    "reviewer",
    "notes",
    "decided_at",
    "packet_ref"
  ],
  "properties": {
    "contract_version": {"type": "string", "const": "a2a.v1"},
    "trace_id": {"type": "string"},
    "review_id": {"type": "string"},
    "packet_ref": {"type": "string"},
    "decision": {"type": "string", "enum": ["approve", "reject", "hold", "escalate"]},
    "reviewer": {
      "type": "object",
      "required": ["actor_id", "actor_role"],
      "properties": {
        "actor_id": {"type": "string"},
        "actor_role": {"type": "string"},
        "display_name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "notes": {"type": "string"},
    "decided_at": {"type": "string", "format": "date-time"},
    "resume_allowed": {"type": "boolean"},
    "escalation_target": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
