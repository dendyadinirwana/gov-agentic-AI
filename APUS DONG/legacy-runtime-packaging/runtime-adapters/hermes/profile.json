{
  "adapter_name": "hermes",
  "adapter_path": "runtime-adapters/hermes/profile.json",
  "description": "Hermes profile: persistent identity with explicit local-vs-mem9 precedence and role-restricted memory behavior.",
  "folder_strategy": "repo-relative-persistent-agent-home",
  "skill_loading": "Load active role skills and shared guardrail skill at session boot; preserve active role restrictions in persistent memory.",
  "config_entrypoint": "configs/runtime.generated.json",
  "adapter_docs": [
    "runtime-adapters/hermes/HERMES.md",
    "runtime-adapters/universal/BOOT_SEQUENCE.md"
  ],
  "runtime_paths": {
    "agent_home": ".",
    "system_prompt_mount": "prompts/system/YayakAI_Master_System_Prompt_v3.0.md",
    "skills_mount": "skills",
    "knowledge_mount": "knowledge-base",
    "memory_policy_doc": "runtime-adapters/hermes/HERMES.md",
    "schemas_mount": "schemas"
  },
  "runtime_overrides": {
    "memory_precedence": "local_knowledge_wins_over_mem9_when_conflicting",
    "session_memory_backend": "mem9_when_memory_mode_is_mem9_or_hybrid",
    "canonical_knowledge_mutability": "read_only_by_default",
    "decision_engine_entrypoint": "scripts/government_decision_engine.py",
    "government_work_logic": "docs/architecture/GOVERNMENT_WORK_LOGIC.md",
    "authority_matrix": "configs/authority_matrix.json"
  },
  "canonical_home_root": "~/.hermes",
  "install_target_root": "~/.hermes/gov-agentic-ai",
  "install_target_config": "~/.hermes/gov-agentic-ai/runtime.generated.json",
  "install_target_skills": "~/.hermes/gov-agentic-ai/skills",
  "install_layout": "runtime-home",
  "central_home_root": "~/.gov-agentic-ai",
  "attach_strategy": "thin-shim-pointer",
  "shim_local_skill_required": [
    "gov-gov-ai-yayak",
    "gov-agentic-common"
  ],
  "canonical_role_resolution": "central-home",
  "runtime_capabilities": {
    "bootstrap_mode": "bootstrap-json-plus-pointer",
    "central_home_required": true,
    "pointer_config_required": true,
    "symlink_optional": true,
    "decision_engine_required": true,
    "local_bootstrap_skills": [
      "gov-gov-ai-yayak",
      "gov-agentic-common"
    ],
    "runtime_healthcheck_supported": true
  },
  "runtime_native_exports": [
    {
      "file": "hermes.runtime.config.yaml",
      "format": "yaml",
      "description": "Clean hermes runtime shim export with MCP config and canonical Gov-Agentic AI pointers."
    }
  ]
}
