{
  "adapter_name": "openclaw",
  "adapter_path": "runtime-adapters/openclaw/profile.json",
  "description": "OpenClaw profile: mount repo root, use runtime.generated.json as activation config, load skills from skill_manifest.",
  "folder_strategy": "repo-relative-mounted",
  "skill_loading": "Use skills/skill_manifest.json as registry; activate only active_skills from runtime config.",
  "config_entrypoint": "configs/runtime.generated.json",
  "adapter_docs": [
    "runtime-adapters/openclaw/OPENCLAW.md",
    "runtime-adapters/universal/BOOT_SEQUENCE.md"
  ],
  "runtime_paths": {
    "repo_mount": ".",
    "system_prompt_mount": "prompts/system/YayakAI_Master_System_Prompt_v3.0.md",
    "skills_mount": "skills/roles",
    "shared_skill_mount": "skills/_shared/gov-agentic-common",
    "knowledge_mount": "knowledge-base",
    "schemas_mount": "schemas"
  },
  "runtime_overrides": {
    "router_mode": "manifest-driven",
    "skill_registry_mode": "skill_manifest",
    "knowledge_resolver": "role_knowledge_then_shared_links",
    "decision_engine_entrypoint": "scripts/government_decision_engine.py",
    "government_work_logic": "docs/architecture/GOVERNMENT_WORK_LOGIC.md",
    "authority_matrix": "configs/authority_matrix.json"
  },
  "canonical_home_root": "~/.openclaw",
  "install_target_root": "~/.openclaw/gov-agentic-ai",
  "install_target_config": "~/.openclaw/gov-agentic-ai/runtime.generated.json",
  "install_target_skills": "~/.openclaw/gov-agentic-ai/skills",
  "install_layout": "runtime-home",
  "central_home_root": "~/.gov-agentic-ai",
  "attach_strategy": "thin-shim-pointer",
  "shim_local_skill_required": [
    "gov-gov-ai-yayak",
    "gov-agentic-common"
  ],
  "canonical_role_resolution": "central-home",
  "runtime_capabilities": {
    "bootstrap_mode": "bootstrap-json-plus-pointer",
    "central_home_required": true,
    "pointer_config_required": true,
    "symlink_optional": true,
    "decision_engine_required": true,
    "local_bootstrap_skills": [
      "gov-gov-ai-yayak",
      "gov-agentic-common"
    ],
    "runtime_healthcheck_supported": true
  }
}
